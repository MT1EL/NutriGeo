# Backend base URL — overridden in EAS builds via the production env block.
EXPO_PUBLIC_API_URL=https://nutrigeo-api.onrender.com

# Sentry DSN — leave empty to disable. Get the project DSN from
# https://sentry.io/settings/<org>/projects/<project>/keys/
EXPO_PUBLIC_SENTRY_DSN=https://1f16a3cc3187ba15498fd82113904faf@o4511331618914304.ingest.de.sentry.io/4511331623567440

# RevenueCat SDK keys.
# - For early dev: set EXPO_PUBLIC_REVENUECAT_API_KEY to the universal test
#   key (prefix `test_`) RC gives you on first signup. Works on iOS + Android.
# - For store builds: leave the universal key empty and set the platform-
#   specific keys (prefix `appl_*` for iOS, `goog_*` for Android) under EAS
#   env config per build profile. lib/purchases.ts prefers the universal key
#   when both are present, so empty it out before shipping production.
EXPO_PUBLIC_REVENUECAT_API_KEY=test_SFxOamLavERPvNzxcKxREXLmtgU
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
